#!/usr/bin/env bash
# LED name badge controller — wraps led-name-badge-ls32
# Device: wch.cn CH583 (0x0416:0x5020)
# Repo:   https://github.com/jnweiger/led-name-badge-ls32

set -euo pipefail

BADGE_SCRIPT="/tmp/led-name-badge-ls32/led-badge-11x44.py"
PYTHON="python3"
export DYLD_LIBRARY_PATH="/opt/homebrew/lib"

# ── defaults ────────────────────────────────────────────────────────────────
SPEED=3
BRIGHTNESS=100
MODE=0
BLINK=0
ANTS=0
TYPE="11x44"
METHOD="auto"
DEVICE_ID="auto"
LIST_ICONS=0
SHOW_HELP=0

usage() {
  cat <<EOF
Usage: badge [OPTIONS] "message" ["message2" ...]

Up to 8 messages. Embed icons with :name: syntax, e.g. "I :heart2: you".
Use :path/to/image.png: to embed custom images.
Separate per-message values with commas (e.g. -s 1,4,8).

OPTIONS
  -s, --speed SPEED         Scroll speed 1-8 (default: $SPEED)
                              per-message: -s 1,4,8
  -B, --brightness PERCENT  25 | 50 | 75 | 100 (default: $BRIGHTNESS)
  -m, --mode MODE           0  scroll-left  (default)
                            1  scroll-right
                            2  scroll-up
                            3  scroll-down
                            4  still-centered
                            5  animation (frames must be 48px wide)
                            6  drop-down
                            7  curtain
                            8  laser
                            9  smooth
                            10 rotate
                              per-message: -m 0,4,8
  -b, --blink 0|1           Blinking (default: $BLINK)
                              per-message: -b 0,1,0
  -a, --ants 0|1            Animated border (default: $ANTS)
                              per-message: -a 1,0
  -t, --type TYPE           11x44 (default) or 12x48
  -M, --method METHOD       auto | hidapi | usb (default: auto)
  -D, --device-id ID        auto or device id if multiple badges connected
  -l, --list-icons          List built-in icon names and exit
  -h, --help                Show this help

EXAMPLES
  badge "Hello World"
  badge -s 5 -m 8 "LASER"
  badge -m 4 -B 50 "still text"
  badge -a 1 -b 1 "blinking border"
  badge -m 5 -s 2 "  :heart2:    :HEART2:"
  badge -s 1,8 -m 0,4 "fast scroll" "still msg"
  badge "I :HEART2: you"
  badge ":ball: score: 42"
  badge ":path/to/logo.png: my badge"

ICONS
  :ball: :happy: :happy2: :heart: :HEART: :heart2: :HEART2:
  :fablab: :bicycle: :bicycle_r: :owncloud: ::
  or any PNG: :path/to/image.png:
EOF
}

MESSAGES=()
EXTRA_ARGS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s|--speed)        SPEED="$2";        shift 2 ;;
    -B|--brightness)   BRIGHTNESS="$2";   shift 2 ;;
    -m|--mode)         MODE="$2";         shift 2 ;;
    -b|--blink)        BLINK="$2";        shift 2 ;;
    -a|--ants)         ANTS="$2";         shift 2 ;;
    -t|--type)         TYPE="$2";         shift 2 ;;
    -M|--method)       METHOD="$2";       shift 2 ;;
    -D|--device-id)    DEVICE_ID="$2";    shift 2 ;;
    -l|--list-icons)   LIST_ICONS=1;      shift ;;
    -h|--help)         SHOW_HELP=1;       shift ;;
    -*)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *) MESSAGES+=("$1"); shift ;;
  esac
done

if [[ $SHOW_HELP -eq 1 ]]; then
  usage
  exit 0
fi

if [[ $LIST_ICONS -eq 1 ]]; then
  sudo $PYTHON "$BADGE_SCRIPT" -l
  exit 0
fi

if [[ ${#MESSAGES[@]} -eq 0 ]]; then
  echo "Error: at least one message required." >&2
  usage >&2
  exit 1
fi

CMD=(
  sudo $PYTHON "$BADGE_SCRIPT"
  -t "$TYPE"
  -M "$METHOD"
  -D "$DEVICE_ID"
  -s "$SPEED"
  -B "$BRIGHTNESS"
  -m "$MODE"
  -b "$BLINK"
  -a "$ANTS"
  "${MESSAGES[@]}"
)

echo "→ Sending to badge: ${MESSAGES[*]}" >&2
"${CMD[@]}"
